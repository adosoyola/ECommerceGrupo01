@{
  ViewData["Title"] = "Compra Exitosa";
}

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <div class="card shadow-sm border-0">
        <div class="card-body py-5">
          <!-- Mostrar mensaje de éxito -->
          @if (TempData["Success"] != null)
          {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              @TempData["Success"]
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          }

          <div class="text-success mb-4">
            <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
          </div>

          <h1 class="card-title text-success mb-3">¡Compra Exitosa! ✅</h1>

          <p class="card-text text-muted mb-4">
            Tu pago simulado fue procesado correctamente.
          </p>

          <div class="d-grid gap-2 d-md-block">
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">
              <i class="bi bi-bag me-2"></i>Seguir Comprando
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>