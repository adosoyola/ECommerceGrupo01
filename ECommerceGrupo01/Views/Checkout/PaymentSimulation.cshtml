@model List<ECommerce.Models.CartItem>

@{
    ViewData["Title"] = "Simulación de Pago";
    var total = Model.Sum(x => x.UnitPrice * x.Quantity);
    var totalFormatted = total.ToString("C", new System.Globalization.CultureInfo("es-PE"));
}

<div class="container mt-5">
    <h1 class="text-center mb-4">💳 Finalizar Compra (Simulación)</h1>

    <!-- Mostrar mensajes de error -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    Resumen del Pedido
                </div>
                <div class="card-body">
                    <p class="h5">Productos:</p>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.Name (@item.Quantity)</span>
                                <strong>@((item.UnitPrice * item.Quantity).ToString("C", new
                                                                    System.Globalization.CultureInfo("es-PE")))</strong>
                            </li>
                        }
                    </ul>
                    <h4 class="text-end">Total a Pagar: <span class="text-success fw-bold">@totalFormatted</span></h4>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    Datos de Pago
                </div>
                <div class="card-body">
                    <form asp-controller="Checkout" asp-action="ProcessPaymentSimulation" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="CardNumber" class="form-label">Número de tarjeta</label>
                            <input type="text" class="form-control" id="CardNumber" name="CardNumber" required
                                maxlength="19" placeholder="XXXX XXXX XXXX XXXX" autocomplete="off"
                                value="@(ViewData["CardNumber"] ?? "")">
                            <div class="form-text">Usar: 4111 1111 1111 1111 (Éxito)</div>
                            <span class="text-danger field-validation-valid" data-valmsg-for="CardNumber"
                                data-valmsg-replace="true"></span>
                        </div>

                        <div class="row">
                            <div class="col-7 mb-3">
                                <label for="Expiration" class="form-label">Fecha de expiración (MM/AA)</label>
                                <input type="text" class="form-control" id="Expiration" name="Expiration" required
                                    maxlength="5" placeholder="MM/AA" autocomplete="off"
                                    value="@(ViewData["Expiration"] ?? "")">
                                <span class="text-danger field-validation-valid" data-valmsg-for="Expiration"
                                    data-valmsg-replace="true"></span>
                            </div>

                            <div class="col-5 mb-3">
                                <label for="CVV" class="form-label">CVV</label>
                                <input type="text" class="form-control" id="CVV" name="CVV" required maxlength="4"
                                    placeholder="123" autocomplete="off" value="@(ViewData["CVV"] ?? "")">
                                <span class="text-danger field-validation-valid" data-valmsg-for="CVV"
                                    data-valmsg-replace="true"></span>
                            </div>
                        </div>

                        <input type="hidden" name="Amount" value="@total" />

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-lock-fill me-2"></i> Pagar @totalFormatted
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-link text-muted">Volver al Carrito</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script simplificado - solo formato básico
        document.addEventListener('DOMContentLoaded', function () {
            const cardNumber = document.getElementById('CardNumber');
            const expiration = document.getElementById('Expiration');
            const cvv = document.getElementById('CVV');

            // Formato de tarjeta
            if (cardNumber) {
                cardNumber.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 16) value = value.substring(0, 16);

                    let formatted = '';
                    for (let i = 0; i < value.length; i += 4) {
                        formatted += value.substring(i, i + 4) + ' ';
                    }
                    e.target.value = formatted.trim();
                });
            }

            // Formato de expiración
            if (expiration) {
                expiration.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 4) value = value.substring(0, 4);

                    if (value.length >= 2) {
                        e.target.value = value.substring(0, 2) + '/' + value.substring(2, 4);
                    } else {
                        e.target.value = value;
                    }
                });
            }

            // Solo números para CVV
            if (cvv) {
                cvv.addEventListener('input', function (e) {
                    e.target.value = e.target.value.replace(/\D/g, '');
                });
            }
        });
    </script>
}