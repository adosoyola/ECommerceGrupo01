@model List<ECommerce.Models.CartItem>

@{
    ViewData["Title"] = "Simulación de Pago";

    var subtotal = (decimal)ViewBag.Subtotal;
    var shippingCost = (decimal)ViewBag.ShippingCost;
    var total = subtotal + shippingCost;
    var deliveryMethod = ViewBag.DeliveryMethod as string ?? "HomeDelivery";

    var culture = new System.Globalization.CultureInfo("es-PE");
}

<div class="container mt-5">
    <h1 class="text-center mb-4">💳 Finalizar Compra</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <!-- Resumen del pedido -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-bag-check"></i> Resumen del Pedido
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.Image) ? "/imagenes/no-image.png" : item.Image)"
                                         alt="@item.Name"
                                         class="rounded border me-3"
                                         style="width: 50px; height: 50px; object-fit: cover;" />
                                    <div>
                                        <h6 class="my-0">@item.Name</h6>
                                        <small class="text-muted">Cant: @item.Quantity</small>
                                    </div>
                                </div>
                                <span class="text-muted fw-bold">
                                    @((item.UnitPrice * item.Quantity).ToString("C", culture))
                                </span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Subtotal:</span>
                        <span>@subtotal.ToString("C", culture)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Costo de Envío:</span>
                        <span>@shippingCost.ToString("C", culture)</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center fs-4 fw-bold text-success">
                        <span>Total a Pagar:</span>
                        <span>@total.ToString("C", culture)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario de pago -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-credit-card"></i> Datos de Pago
                </div>
                <div class="card-body">
                    @if (deliveryMethod == "HomeDelivery")
                    {
                        <div class="alert alert-info mb-3 border-info d-flex align-items-center">
                            <i class="bi bi-truck-front-fill fs-3 me-3"></i>
                            <div>
                                <strong>Envío a Domicilio</strong> <br />
                                <small>(Llega en máximo 2 días hábiles)</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3 border-warning text-dark d-flex align-items-center">
                            <i class="bi bi-shop fs-3 me-3"></i>
                            <div>
                                <strong>Recojo en Tienda</strong> <br />
                                <small>(Debe acercarse al local)</small>
                            </div>
                        </div>
                    }

                    <form asp-controller="Checkout" asp-action="ProcessPaymentSimulation" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="CardNumber" class="form-label fw-bold">Número de tarjeta</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card-2-front"></i></span>
                                <input type="text" class="form-control" id="CardNumber" name="CardNumber" required
                                       maxlength="19" placeholder="0000 0000 0000 0000" autocomplete="off" />
                            </div>
                            <div class="form-text text-muted">Tarjeta de prueba: 4111 1111 1111 1111</div>
                        </div>

                        <div class="row">
                            <div class="col-7 mb-3">
                                <label for="Expiration" class="form-label fw-bold">Vencimiento</label>
                                <input type="text" class="form-control" id="Expiration" name="Expiration" required
                                       maxlength="5" placeholder="MM/AA" autocomplete="off" />
                            </div>

                            <div class="col-5 mb-3">
                                <label for="CVV" class="form-label fw-bold">CVV</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="CVV" name="CVV" required maxlength="4"
                                           placeholder="123" autocomplete="off" />
                                    <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="Amount" value="@total" />
                        <input type="hidden" name="DeliveryMethod" value="@deliveryMethod" />

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg shadow hover-effect">
                                Pagar @total.ToString("C", culture) <i class="bi bi-check-circle-fill ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <a asp-controller="Checkout" asp-action="Confirm" class="btn btn-link text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Volver a Confirmación
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cardNumber = document.getElementById('CardNumber');
            const expiration = document.getElementById('Expiration');
            const cvv = document.getElementById('CVV');

            if (cardNumber) {
                cardNumber.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 16) value = value.substring(0, 16);
                    let formatted = '';
                    for (let i = 0; i < value.length; i += 4) {
                        formatted += value.substring(i, i + 4) + ' ';
                    }
                    e.target.value = formatted.trim();
                });
            }

            if (expiration) {
                expiration.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 4) value = value.substring(0, 4);
                    if (value.length >= 2) {
                        e.target.value = value.substring(0, 2) + '/' + value.substring(2, 4);
                    } else {
                        e.target.value = value;
                    }
                });
            }

            if (cvv) {
                cvv.addEventListener('input', function (e) {
                    e.target.value = e.target.value.replace(/\D/g, '');
                });
            }
        });
    </script>
}
