@model List<ECommerce.Models.Order>

@using System.Globalization
@using ECommerce.Models

@{
    ViewData["Title"] = "Historial de Compras";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">

    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SYSTEMCUSCO</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-shop"></i> Productos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Checkout" asp-action="History">
                        <i class="bi bi-receipt"></i> Mis pedidos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-cart3"></i> Carrito de Compras
                    </a>
                </li>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <li class="nav-item">
    <a href="#"
       class="nav-link text-danger"
       onclick="document.getElementById('logoutForm').submit(); return false;">
        🚪 Cerrar sesión (@User.Identity.Name.Split('@')[0])
    </a>

    <form id="logoutForm"
          asp-area="Identity"
          asp-page="/Account/Logout"
          method="post"
          class="d-none">
    </form>
</li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">🔑 Iniciar sesión</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <h1>📜 Historial de Pedidos</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No tienes pedidos realizados. ¡Anímate a comprar!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID Pedido</th>
                        <th>Fecha</th>
                        <th>Productos</th>
                        <th>Total</th>
                        <th>Estado</th> @* 🔑 COLUMNA NUEVA *@
                        <th style="width: 150px;">Acciones</th> @* 🔑 COLUMNA NUEVA *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <ul class="mb-0">
                                    @foreach (var item in order.Items)
                                    {
                                        <li>
                                            <span class="fw-bold">@(item.Product?.Name ?? item.ProductName)</span>
                                            (<span class="text-primary">@item.Quantity UND</span>) –
                                            <span class="text-success">@item.UnitPrice.ToString("C", new
                                                                                    CultureInfo("es-PE"))</span>
                            </li>
                                                        }
                                </ul>
                            </td>
                            <td>
                                <span class="fw-bold text-success">
                                    @order.Total.ToString("C", new CultureInfo("es-PE"))
                                </span>
                            </td>

                            @* 🔑 MOSTRAR ESTADO CON UN BADGE *@
                            <td>
                                @{
                                    var badgeClass = order.Status switch
                                    {
                                        OrderStatus.Entregado => "bg-success",
                                        OrderStatus.EnTransito => "bg-primary",
                                        OrderStatus.EnPreparacion => "bg-warning text-dark",
                                        OrderStatus.Cancelado => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">
                                    @order.Status.ToString()
                                </span>
                            </td>

                            @* 🔑 BOTONES DE ACCIÓN *@
                            <td>
                                <div class="btn-group" role="group">
                                    @* Botón Detalle (redirige a la nueva acción Details) *@
                                    <a asp-controller="Checkout" asp-action="Details" asp-route-id="@order.Id"
                                        class="btn btn-sm btn-info" title="Ver Detalle">
                                        <i class="bi bi-eye"></i> Detalle
                                    </a>

                                    @* Botón Exportar PDF (redirige a la nueva acción ExportToPdf) *@
                                    <a asp-controller="Checkout" asp-action="ExportToPdf" asp-route-id="@order.Id"
                                        target="_blank" class="btn btn-sm btn-danger" title="Exportar Factura como PDF">
                                        <i class="bi bi-file-earmark-pdf"></i> PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>