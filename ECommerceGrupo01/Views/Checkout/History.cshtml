@model List<ECommerce.Models.Order>
@using System.Globalization
@using ECommerce.Models

@{
    ViewData["Title"] = "Historial de Compras";
    var culture = new CultureInfo("es-PE");
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SYSTEMCUSCO</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-shop"></i> Productos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Checkout" asp-action="History"><i class="bi bi-receipt"></i> Mis pedidos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3"></i> Carrito</a>
                </li>
            </ul>
            <partial name="_LoginPartial" />
        </div>
    </div>
</nav>

<div class="container mt-4">
    <h2 class="mb-4">📜 Mis Pedidos</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4>No has realizado ninguna compra todavía.</h4>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-2">Ir a comprar</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th># Orden</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Entrega</th> <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">@order.Id</td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-success">@order.Total.ToString("C", culture)</td>
                            
                            <td>
                                @if (order.DeliveryMethod == ECommerce.Models.DeliveryMethod.HomeDelivery)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-truck"></i> Envío (2 días)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-shop"></i> Recojo en Tienda</span>
                                }
                            </td>

                            <td>
                                @{
                                    var badgeClass = order.Status switch
                                    {
                                        OrderStatus.Entregado => "bg-success",
                                        OrderStatus.EnTransito => "bg-primary",
                                        OrderStatus.EnPreparacion => "bg-warning text-dark",
                                        OrderStatus.Cancelado => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@order.Status.ToString()</span>
                            </td>
                            <td>
                                <a asp-controller="Checkout" asp-action="Details" asp-route-id="@order.Id"
                                    class="btn btn-sm btn-info text-white" title="Ver Detalle">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Checkout" asp-action="ExportToPdf" asp-route-id="@order.Id"
                                    target="_blank" class="btn btn-sm btn-danger" title="Descargar Factura">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>