@model ECommerce.Models.Order
@using ECommerce.Models
@using System.Globalization

@{
    ViewData["Title"] = $"Detalle Orden #{Model.Id}";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var culture = new CultureInfo("es-PE");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800">📦 Detalle de Orden #@Model.Id</h2>
        <a asp-action="Index" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <div class="row">
        <!-- COLUMNA IZQUIERDA: Detalles -->
        <div class="col-lg-8">
            
            <!-- Tarjeta de Productos -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-primary text-white">
                    <h6 class="m-0 fw-bold"><i class="bi bi-cart4"></i> Productos Comprados</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@(item.Product?.Name ?? item.ProductName)</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C", culture)</td>
                                        <td class="text-end">@((item.Quantity * item.UnitPrice).ToString("C", culture))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Subtotal Productos:</td>
                                    <td class="text-end">@((Model.Total - Model.ShippingCost).ToString("C", culture))</td>
                                </tr>
                                @if (Model.ShippingCost > 0)
                                {
                                    <tr class="text-danger fw-bold">
                                        <td colspan="3" class="text-end">+ Costo de Envío:</td>
                                        <td class="text-end">@Model.ShippingCost.ToString("C", culture)</td>
                                    </tr>
                                }
                                <tr class="bg-success text-white fw-bold fs-5">
                                    <td colspan="3" class="text-end">TOTAL COBRADO:</td>
                                    <td class="text-end">@Model.Total.ToString("C", culture)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Información de Entrega (NUEVO) -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 @(Model.DeliveryMethod == DeliveryMethod.HomeDelivery ? "bg-info text-white" : "bg-warning text-dark")">
                    <h6 class="m-0 fw-bold">
                        <i class="bi @(Model.DeliveryMethod == DeliveryMethod.HomeDelivery ? "bi-truck" : "bi-shop")"></i>
                        Método de Entrega: @(Model.DeliveryMethod == DeliveryMethod.HomeDelivery ? "ENVÍO A DOMICILIO" : "RECOJO EN TIENDA")
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Cliente:</strong> @(Model.User?.UserName ?? "Usuario eliminado")</p>
                            <p><strong>Email:</strong> @(Model.User?.Email ?? "-")</p>
                        </div>
                        <div class="col-md-6">
                            @if (Model.DeliveryMethod == DeliveryMethod.HomeDelivery)
                            {
                                <div class="alert alert-light border-info">
                                    <h5 class="alert-heading text-info"><i class="bi bi-geo-alt-fill"></i> Dirección de Envío</h5>
                                    <p class="mb-0">El cliente espera el producto en su domicilio.</p>
                                    <small class="text-muted">(Aquí podrías mostrar la dirección si la guardáramos en el futuro)</small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border-warning">
                                    <h5 class="alert-heading text-warning"><i class="bi bi-person-raised-hand"></i> Cliente Recoge</h5>
                                    <p class="mb-0">El cliente vendrá a la tienda a recoger el pedido.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- COLUMNA DERECHA: Acciones -->
        <div class="col-lg-4">
            
            <!-- Cambiar Estado -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-dark text-white">
                    <h6 class="m-0 fw-bold"><i class="bi bi-gear-fill"></i> Gestión de Estado</h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <p>Estado Actual:</p>
                        @{
                            var badgeClass = Model.Status switch {
                                OrderStatus.Pendiente => "bg-secondary",
                                OrderStatus.EnPreparacion => "bg-primary",
                                OrderStatus.EnTransito => "bg-info text-dark",
                                OrderStatus.ListoParaRecoger => "bg-warning text-dark",
                                OrderStatus.Entregado => "bg-success",
                                OrderStatus.Cancelado => "bg-danger",
                                _ => "bg-light text-dark"
                            };
                        }
                        <span class="badge @badgeClass fs-4 p-2">@Model.Status</span>
                    </div>

                    <hr>

                    <form asp-action="UpdateStatus" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    
    <label class="form-label fw-bold">Cambiar a:</label>
    <select name="newStatus" class="form-select mb-3 form-select-lg">
        
        <option value="Pendiente" selected="@(Model.Status == OrderStatus.Pendiente)">
            🕒 Pendiente
        </option>
        
        <option value="EnPreparacion" selected="@(Model.Status == OrderStatus.EnPreparacion)">
            ⚙️ En Preparación
        </option>

        <option value="EnTransito" selected="@(Model.Status == OrderStatus.EnTransito)">
            🚚 En Tránsito (Salió a Reparto)
        </option>

        <option value="ListoParaRecoger" selected="@(Model.Status == OrderStatus.ListoParaRecoger)">
            🏪 Listo para Recogerse (En Tienda)
        </option>

        <option value="Entregado" selected="@(Model.Status == OrderStatus.Entregado)">
            ✅ Entregado / Finalizado
        </option>
        
        <option value="Cancelado" selected="@(Model.Status == OrderStatus.Cancelado)">
            ❌ Cancelado
        </option>
    </select>

    <button type="submit" class="btn btn-success w-100 btn-lg">
        <i class="bi bi-check-lg"></i> Actualizar Estado
    </button>
</form>
                </div>
            </div>

            <!-- Acciones Extra -->
            <div class="card shadow">
                <div class="card-body d-grid gap-2">
                    <a asp-action="ExportToPdf" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-danger">
                        <i class="bi bi-file-earmark-pdf"></i> Ver Factura PDF
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>