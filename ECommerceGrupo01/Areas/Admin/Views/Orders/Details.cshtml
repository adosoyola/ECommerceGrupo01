@model ECommerce.Models.Order
@using ECommerce.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = $"Detalle de Orden #{Model.Id}";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    // El ViewBag.Statuses viene del OrdersController.Details
    var statuses = ViewBag.Statuses as List<SelectListItem>;
    
    // Lógica para asignar colores al estado (igual que en Index.cshtml)
    var badgeClass = Model.Status switch
    {
        OrderStatus.Entregado => "bg-success",
        OrderStatus.EnTransito => "bg-primary",
        OrderStatus.EnPreparacion => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-receipt"></i> Detalle de Orden <span class="text-info">#@Model.Id</span></h2>
    
    <a asp-area="Admin" asp-controller="Orders" asp-action="ExportToPdf" asp-route-id="@Model.Id"
       target="_blank" class="btn btn-danger">
        <i class="bi bi-file-earmark-pdf"></i> Exportar Factura (PDF)
    </a>
</div>

<div class="row">
    @* Columna de Detalle de la Orden y Cliente *@
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Información de la Orden</h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Fecha de Creación:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                <li class="list-group-item"><strong>Total de la Orden:</strong> <span class="text-success fw-bold">@Model.Total.ToString("C", new System.Globalization.CultureInfo("es-PE"))</span></li>
                <li class="list-group-item"><strong>Email del Cliente:</strong> @(Model.User?.Email ?? Model.UserId)</li>
                <li class="list-group-item">
                    <strong>Estado Actual:</strong> 
                    <span class="badge @badgeClass fw-bold p-2">
                        @Model.Status.ToString()
                    </span>
                </li>
            </ul>
        </div>

        @* Formulario para Actualizar el Estado *@
        <div class="card bg-light">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-arrow-repeat"></i> Actualizar Estado</h5>
                <form asp-action="UpdateStatus" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="newStatus" class="form-label fw-bold">Nuevo Estado:</label>
                        <select name="newStatus" id="newStatus" class="form-select">
                            @foreach (var item in statuses)
                            {
                                // Selecciona el estado actual por defecto
                                <option value="@item.Value" selected="@(item.Value == Model.Status.ToString())">
                                    @item.Text
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2-square"></i> Guardar Cambio</button>
                </form>
            </div>
        </div>

    </div>

    @* Columna de Ítems de la Orden *@
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Productos Comprados</h5>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.Items)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold">@item.ProductName</span>
                            <br>
                            <small class="text-muted">ID Producto: @item.ProductId</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-secondary me-2">@item.Quantity UNIDADES</span>
                            <span class="text-success fw-bold">@item.UnitPrice.ToString("C", new System.Globalization.CultureInfo("es-PE")) c/u</span>
                        </div>
                    </li>
                }
            </ul>
        </div>
        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver a la Lista</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
