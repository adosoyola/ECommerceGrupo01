@{
    ViewData["Title"] = "📊 Reportes";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="/Admin">⚙️ Panel Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
                data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" 
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Products">📦 Productos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Orders">🛒 Órdenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Users">👥 Usuarios</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/Admin/Reports">📊 Reportes</a>
                </li>
                
            </ul>
        </div>
    </div>
</nav>

<form method="get" asp-action="ExportarPDF" class="mb-3">
    <input type="hidden" name="fechaInicio" value="@ViewBag.FechaInicio" />
    <input type="hidden" name="fechaFin" value="@ViewBag.FechaFin" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
    </button>
</form>
<!-- FILTRO DE FECHAS -->
<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Desde:</label>
        <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Hasta:</label>
        <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-success w-100">Filtrar</button>
    </div>
</form>

<!-- TARJETAS DE TOTALES -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white text-center shadow">
            <div class="card-body">
                <h5>💰 Ventas Totales</h5>
                <h3>S/ @ViewBag.TotalVentas.ToString("N2")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white text-center shadow">
            <div class="card-body">
                <h5>📦 Órdenes Entregadas</h5>
                <h3>@ViewBag.OrdenesEntregadas</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-dark text-white text-center shadow">
            <div class="card-body">
                <h5>🧾 Total de Órdenes</h5>
                <h3>@ViewBag.OrdenesTotales</h3>
            </div>
        </div>
    </div>
</div>

<hr />

<!-- GRÁFICO DE VENTAS -->
<h4 class="mt-4 mb-3">📈 Ventas por día</h4>
<canvas id="ventasChart" height="120"></canvas>

<hr class="my-5" />

<!-- TABLA DE PRODUCTOS MÁS VENDIDOS -->
<h4 class="mt-4 mb-3">🏆 Productos más vendidos</h4>
<table class="table table-striped table-hover align-middle">
    <thead class="table-success">
        <tr>
            <th>Producto</th>
            <th>Cantidad Vendida</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.ProductosMasVendidos)
        {
            <tr>
                <td>@item.Producto</td>
                <td>@item.Cantidad</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = [
            @foreach (var item in ViewBag.VentasPorDia)
            {
                @: "@item.Fecha.ToString("dd/MM")",
                ;
            }
        ];
        const data = [
            @foreach (var item in ViewBag.VentasPorDia)
            {
                @: @item.Total,
                ;
            }
        ];

        const ctx = document.getElementById('ventasChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Ventas (S/)',
                    data: data,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.5)',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}