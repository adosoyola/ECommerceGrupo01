@model ECommerce.Models.Product
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Eliminar Producto";
}

<h2 class="text-danger">🗑️ Eliminar Producto</h2>

<div class="alert alert-warning">
    <strong>¿Estás seguro de eliminar este producto?</strong>
</div>

<div class="card p-3">
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Price</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Imagen</dt>
        <dd class="col-sm-10">
            <img src="@Model.ImagePath" alt="@Model.Name" width="150" class="img-thumbnail" />
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
