@model ECommerce.Models.Product
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Editar Producto";
}

<h2 class="mb-4">✏️ Editar Producto</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <!-- Nombre -->
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold">📦 Nombre del producto</label>
                    <input asp-for="Name" class="form-control" placeholder="Ej. Monitor Gamer" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Precio -->
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-bold">💰 Precio (S/)</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Ej. 1200.00" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <!-- Descripción -->
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-bold">📝 Descripción</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe el producto..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Stock -->
                <div class="col-md-6">
                    <label asp-for="Stock" class="form-label fw-bold">📦 Stock disponible</label>
                    <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="Ej. 50" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>

                <!-- Imagen actual -->
                <div class="col-md-6 text-center">
                    <label class="form-label fw-bold">🖼️ Imagen actual</label>
                    <div class="border rounded p-2 bg-light">
                        <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? Url.Content("~/imagenes/no-image.png") : Model.ImagePath)"
                             alt="@Model.Name"
                             width="180"
                             class="img-thumbnail" />
                    </div>
                </div>

                <!-- Nueva imagen -->
                <div class="col-12 mt-3">
                    <label class="form-label fw-bold">📁 Cambiar imagen (opcional)</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">⬅️ Volver</a>
                <button type="submit" class="btn btn-primary">💾 Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}