@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Configurar Envío";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0"><i class="bi bi-truck"></i> Configurar Costo de Envío</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Este precio se aplicará a todos los nuevos pedidos que seleccionen 
                        <strong>"Envío a Domicilio"</strong>.
                    </p>

                    <form asp-action="ConfigShipping" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Costo de Envío (S/)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">S/</span>
                                <input type="number" name="newCost" class="form-control" 
                                       value="@(ViewBag.CurrentCost?.ToString().Replace(",", "."))" 
                                       step="0.10" min="0" required />
                            </div>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>