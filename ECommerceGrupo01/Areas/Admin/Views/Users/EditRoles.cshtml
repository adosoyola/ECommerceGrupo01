@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = $"Editar Roles de {Model.Email}";
    // 🔑 Aseguramos el mismo Layout que usa Index.cshtml
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var isAdmin = (bool)ViewBag.IsAdmin;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-person-gear"></i> Gestión de Roles</h2>
</div>

<h4 class="text-muted">Editando Usuario: <span class="fw-bold">@Model.Email</span></h4>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="EditRoles" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-check form-switch mb-3 p-0">
                <label class="form-check-label fw-bold mb-2" for="isAdminSwitch">
                    Asignar Rol de Administrador (ADMIN)
                </label>
                <input class="form-check-input" type="checkbox" id="isAdminSwitch" name="isAdmin" 
                       checked="@isAdmin" value="true" style="transform: scale(1.5);">
            </div>
            
            <p class="text-warning small mt-2">
                Al activar/desactivar el switch, se le concederá o retirará el acceso a la zona de administración.
            </p>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar Roles</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver a la Lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}