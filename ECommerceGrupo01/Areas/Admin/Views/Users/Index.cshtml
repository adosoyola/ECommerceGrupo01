@model List<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Lista de Usuarios";
    // Usa el Layout de Admin para mantener la navegación.
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">👥 Lista de Usuarios Registrados</h2>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Email (Nombre de Usuario)</th>
            <th>Email Confirmado</th>
            <th>Id de Usuario</th>
            <th style="width: 20%;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    @if (user.EmailConfirmed)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td>@user.Id</td>
                <td>

                    <a asp-action="EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-gear-fill"></i> Roles
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>